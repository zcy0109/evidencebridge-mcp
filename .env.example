# Database (Docker Compose defaults)
POSTGRES_DB=evidencebridge
POSTGRES_USER=evidencebridge
POSTGRES_PASSWORD=change-me-for-nonlocal-use
DATABASE_URL=postgresql://evidencebridge:change-me-for-nonlocal-use@localhost:5432/evidencebridge?schema=public

# Services
FLASK_SERVICE_URL=http://localhost:5001
MCP_SERVER_COMMAND=node
MCP_SERVER_ARGS=../mcp-server/dist/index.js
MCP_SERVER_PATH=../mcp-server/dist/index.js
NEXT_PUBLIC_APP_URL=http://localhost:3000
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
REQUEST_TIMEOUT_SECONDS=15
EVIDENCEBRIDGE_API_TOKEN=local-demo-token

# Model provider: mock | openai-compatible | azure
MODEL_PROVIDER=mock
MODEL_NAME=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Azure adapter is implemented but has NOT been verified against a live deployment.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT=
